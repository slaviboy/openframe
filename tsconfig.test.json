{
  // Unit/integration tests run in Node under Vitest and may use Node APIs
  // (e.g. loading CanvasKit from node_modules for engine golden tests).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests"],
  "exclude": ["src/pwa/sw.ts"]
}
