{
  // The core layer (document model, math, layout, animation, prototype logic) must not
  // depend on the DOM, React, CanvasKit, or any IO. This project typechecks it without
  // DOM lib types so an accidental `window`/`document` reference fails the build.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/core"],
  "exclude": ["src/core/**/*.test.ts"]
}
